# Copie para .env e preencha — NUNCA commite o .env
# chmod 600 .env

# Token GitHub (leitura da aba Scans + push de policy via API)
GITHUB_TOKEN=ghp_...

# Repo onde policy.yml vive (para o botão "Commit & Push" do dashboard)
SECPIPE_GITHUB_REPO=k19x/ci_cd

# Token de autenticação do ingest (protege /api/ingest de escrita não autorizada)
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECPIPE_TOKEN=

# Named Tunnel token (apenas para URL permanente com domínio próprio)
# Obtenha com: cloudflared tunnel create secpipe && cloudflared tunnel token secpipe
CLOUDFLARE_TUNNEL_TOKEN=

# AI Engine (Claude) — habilita "Sugerir correção com IA" e "Diagnosticar com IA"
# Obtenha em: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Modelo (opcional; padrão claude-sonnet-5)
# SECPIPE_AI_MODEL=claude-sonnet-5
