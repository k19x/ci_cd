# Copie este arquivo para .env e preencha os valores

# Token do GitHub para a aba Scans (leitura de Actions runs)
GITHUB_TOKEN=ghp_...

# Token de autenticação do dashboard (opcional — protege /api/ingest)
SECPIPE_TOKEN=

# Token do Cloudflare Tunnel (apenas para túnel nomeado com domínio permanente)
# Obtenha com: cloudflared tunnel create secpipe && cloudflared tunnel token secpipe
CLOUDFLARE_TUNNEL_TOKEN=
